{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.proxy302/proxy302-mcp",
  "title": "Proxy302",
  "description": "Residential proxies for AI agents: usage, proxy URLs by country, IP purity checks and cost quotes.",
  "version": "1.1.0",
  "websiteUrl": "https://proxy302.com/developer-docs/",
  "repository": {
    "url": "https://github.com/proxy302/proxy302-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://proxy302.com/brand/partner-kit/proxy302-icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.proxy302.com/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://proxy302.com/v1/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Proxy302 API key from the console, sent as Bearer <key id>:<secret>",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Proxy302 API key as <key id>:<secret>",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
